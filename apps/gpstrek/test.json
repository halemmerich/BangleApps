{
  "app": "gpstrek",
  "setup": [
    {
      "id": "route",
      "steps": [
        {
          "t": "upload",
          "file": "apps/gpstrek/testdata/sample.trf",
          "as": "gpstrek.test.trf",
          "text": "Upload a small .trf route fixture (waypoint types A, C and D)"
        },
        {
          "t": "cmd",
          "js": "try{require('Storage').erase('gpstrek.test.tri')}catch(e){}",
          "text": "Remove any stale index so the parser rebuilds it"
        },
        {
          "t": "cmd",
          "js": "global._gpstrekLib=require('gpstrek.lib.js')",
          "text": "Load the logic library"
        }
      ]
    },
    {
      "id": "badroutes",
      "steps": [
        {
          "t": "upload",
          "file": "apps/gpstrek/testdata/badtype.trf",
          "as": "gpstrek.badtype.trf",
          "text": "Unknown waypoint type"
        },
        {
          "t": "upload",
          "file": "apps/gpstrek/testdata/badposition.trf",
          "as": "gpstrek.badposition.trf",
          "text": "Unparsable coordinates"
        },
        {
          "t": "upload",
          "file": "apps/gpstrek/testdata/truncated.trf",
          "as": "gpstrek.truncated.trf",
          "text": "Truncated waypoint"
        }
      ]
    }
  ],
  "tests": [
    {
      "description": "Geo helpers use circular math and return sensible values",
      "steps": [
        {"t": "cmd", "js": "global._gpstrekLib=require('gpstrek.lib.js')"},
        {"t": "assert", "js": "_gpstrekLib.distance({lat:0,lon:0},{lat:0,lon:1})", "is": "equal", "to": "111195", "text": "One degree of longitude at the equator"},
        {"t": "assert", "js": "_gpstrekLib.bearing({lat:0,lon:0},{lat:0,lon:1})", "is": "equal", "to": "90", "text": "East bearing"},
        {"t": "assert", "js": "_gpstrekLib.bearing({lat:0,lon:0},{lat:1,lon:0})", "is": "equal", "to": "0", "text": "North bearing"},
        {"t": "assert", "js": "_gpstrekLib.averageHeading([350,10])", "is": "equal", "to": "0", "text": "Headings around north average to north"},
        {"t": "assert", "js": "_gpstrekLib.averageHeading([0,90])", "is": "equal", "to": "45"},
        {"t": "assert", "js": "isNaN(_gpstrekLib.distance({lat:0,lon:0},{}))", "is": "false", "text": "distance returns Infinity for incomplete points"}
      ]
    },
    {
      "description": "Route parser loads waypoints, elevation and index data",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekRoute=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){})"},
        {"t": "assert", "js": "_gpstrekRoute.count", "is": "equal", "to": "3"},
        {"t": "assert", "js": "_gpstrekLib.getIndexFileName('gpstrek.test.trf')", "is": "equal", "to": "'gpstrek.test.tri'"},
        {"t": "assert", "js": "_gpstrekLib.getRouteIndex(_gpstrekRoute).length", "is": "equal", "to": "3"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute,0).lat", "is": "equal", "to": "52.52"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute,1).alt", "is": "equal", "to": "120"},
        {"t": "assert", "js": "_gpstrekLib.getLast(_gpstrekRoute).name", "is": "equal", "to": "'Summit'"},
        {"t": "assert", "js": "_gpstrekRoute.length > 1000", "is": "true"},
        {"t": "assert", "js": "_gpstrekRoute.up", "is": "equal", "to": "30", "text": "Elevation gain is accumulated"},
        {"t": "assert", "js": "_gpstrekRoute.down", "is": "equal", "to": "0"}
      ]
    },
    {
      "description": "Waypoint navigation supports next/prev and mirrored routes",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekRoute=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){})"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "0"},
        {"t": "cmd", "js": "_gpstrekLib.next(_gpstrekRoute)"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "1"},
        {"t": "cmd", "js": "_gpstrekLib.next(_gpstrekRoute);_gpstrekLib.next(_gpstrekRoute)"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "2", "text": "next() stops at the last waypoint"},
        {"t": "assert", "js": "_gpstrekLib.isLast(_gpstrekRoute)", "is": "true"},
        {"t": "cmd", "js": "_gpstrekLib.prev(_gpstrekRoute)"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "1"},
        {"t": "cmd", "js": "_gpstrekRoute.mirror=true;_gpstrekRoute.index=0"},
        {"t": "assert", "js": "_gpstrekLib.isLast(_gpstrekRoute)", "is": "true", "text": "Mirroring reverses the active index"}
      ]
    },
    {
      "description": "Closest waypoint search finds the nearest point",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekRoute=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){})"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,0,null,null,{lat:52.5201,lon:13.4051})"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "0"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,0,null,null,{lat:52.5210,lon:13.4060})"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "1"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,undefined,null,null,{lat:52.5210,lon:13.4060})"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "1", "text": "Search stops after passing the closest point"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,0,null,null,{})"},
        {"t": "assert", "js": "_gpstrekRoute.index", "is": "equal", "to": "0", "text": "Without a fix the route stays on the start waypoint"}
      ]
    },
    {
      "description": "App boots with the widget and enters the info view",
      "steps": [
        {"t": "cmd", "js": "global._gpstrekSettings=require('Storage').readJSON('setting.json',true)||{};global._gpstrekSettings.widgets=['gpstrek.wid.js'];require('Storage').writeJSON('setting.json',global._gpstrekSettings)"},
        {"t": "cmd", "js": "eval(require('Storage').read('gpstrek.app.js'))"},
        {"t": "assert", "js": "WIDGETS.gpstrek && WIDGETS.gpstrek.getState().mode", "is": "equal", "to": "2"},
        {"t": "assert", "js": "typeof require('gpstrek.lib.js').distance", "is": "equal", "to": "'function'"}
      ]
    },
    {
      "description": "UI library builds slices and draws without a widget",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekState={currentPos:{lat:52.5201,lon:13.4051,course:90,speed:1.5,alt:120},route:null,waypoint:null,avgComp:90,up:0,down:0,altitude:120,steps:0,calibAltDiff:0,acc:{x:0,y:0},mode:2};global._gpstrekUi=require('gpstrek.ui.js').create({settings:_gpstrekLib.readSettings(),getState:function(){return global._gpstrekState;},screenWidth:176,screenHeight:176})"},
        {"t": "assert", "js": "typeof _gpstrekUi.drawSlices", "is": "equal", "to": "'function'"},
        {"t": "assert", "js": "_gpstrekUi.getSliceHeight() > 0", "is": "true"},
        {"t": "assert", "js": "_gpstrekUi.getMaxSlicePages() > 0", "is": "true"},
        {"t": "cmd", "js": "_gpstrekUi.drawSlices(g,0,true)"},
        {"t": "assert", "js": "true", "is": "true", "text": "Drawing the info slices does not throw"},
        {"t": "cmd", "js": "global._gpstrekState.route=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){});_gpstrekUi.drawMap(g)"},
        {"t": "assert", "js": "true", "is": "true", "text": "Drawing the map with a route does not throw"},
        {"t": "cmd", "js": "_gpstrekUi.toggleOverview();_gpstrekUi.zoom(1);_gpstrekUi.scrollOverview(1,1);_gpstrekUi.toggleScrolling();_gpstrekUi.toggleOverview()"},
        {"t": "assert", "js": "_gpstrekUi.isOverview()", "is": "false"},
        {"t": "assert", "js": "_gpstrekUi.isScrolling()", "is": "false"},
        {"t": "cmd", "js": "for(let i=0;i<200;i++)_gpstrekUi.zoom(-1);global._gpstrekMinScale=_gpstrekUi.getScale()"},
        {"t": "assert", "js": "_gpstrekMinScale >= 0.005", "is": "true", "text": "Zooming out is clamped"},
        {"t": "cmd", "js": "for(let i=0;i<200;i++)_gpstrekUi.zoom(1);global._gpstrekMaxScale=_gpstrekUi.getScale()"},
        {"t": "assert", "js": "_gpstrekMaxScale <= 20 && isFinite(_gpstrekMaxScale)", "is": "true", "text": "Zooming in is clamped"}
      ]
    },
    {
      "description": "Malformed and missing routes are rejected instead of partially loaded",
      "steps": [
        {"t": "setup", "id": "badroutes"},
        {"t": "cmd", "js": "global._gpstrekLib=require('gpstrek.lib.js');global._routeError=function(f){try{_gpstrekLib.loadRouteData(f,function(){});return 'none'}catch(e){return e.message}}"},
        {"t": "assert", "js": "_routeError('gpstrek.badtype.trf').indexOf('Unknown entry type') >= 0", "is": "true", "text": "Unknown entry type is reported"},
        {"t": "assert", "js": "_routeError('gpstrek.badposition.trf').indexOf('Invalid position') >= 0", "is": "true", "text": "Invalid coordinates are reported"},
        {"t": "assert", "js": "_routeError('gpstrek.truncated.trf').indexOf('Invalid position') >= 0", "is": "true", "text": "Truncated entries are reported"},
        {"t": "assert", "js": "_routeError('gpstrek.missing.trf').indexOf('empty or missing') >= 0", "is": "true", "text": "Missing routes are reported"}
      ]
    },
    {
      "description": "A missing index is rebuilt from the route file",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekRoute=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){});require('Storage').erase('gpstrek.test.tri');_gpstrekRoute.indexToOffset=undefined"},
        {"t": "assert", "js": "_gpstrekLib.getRouteIndex(_gpstrekRoute).length", "is": "equal", "to": "3", "text": "Index is rebuilt on demand"},
        {"t": "assert", "js": "(require('Storage').readArrayBuffer('gpstrek.test.tri')||{byteLength:0}).byteLength > 0", "is": "true", "text": "Rebuilt index is persisted"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute,2).name", "is": "equal", "to": "'Summit'"},
        {"t": "cmd", "js": "require('Storage').erase('gpstrek.test.tri');require('Storage').write('gpstrek.test.tri',new Uint32Array([0]),0,20);_gpstrekRoute.indexToOffset=undefined"},
        {"t": "assert", "js": "_gpstrekLib.getRouteIndex(_gpstrekRoute).length", "is": "equal", "to": "3", "text": "An index without the completion marker is rebuilt"}
      ]
    },
    {
      "description": "Closest search works on a mirrored route",
      "steps": [
        {"t": "setup", "id": "route"},
        {"t": "cmd", "js": "global._gpstrekRoute=_gpstrekLib.loadRouteData('gpstrek.test.trf',function(){});_gpstrekRoute.mirror=true;_gpstrekLib.setWaypointIndex(_gpstrekRoute,0)"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute).name", "is": "equal", "to": "'Summit'", "text": "Mirrored route starts at the last physical waypoint"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,0,null,null,{lat:52.5211,lon:13.4061})"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute).lat", "is": "equal", "to": "52.521", "text": "Mirrored search finds the middle waypoint"},
        {"t": "cmd", "js": "_gpstrekLib.setClosestWaypoint(_gpstrekRoute,undefined,null,null,{lat:52.52,lon:13.405})"},
        {"t": "assert", "js": "_gpstrekLib.get(_gpstrekRoute).lat", "is": "equal", "to": "52.52", "text": "Mirrored search follows reversed order"}
      ]
    },
    {
      "description": "Background widget start and stop manage GPS power",
      "steps": [
        {"t": "cmd", "js": "global.WIDGETS={gpstrek:{}};eval(require('Storage').read('gpstrek.wid.js'))"},
        {"t": "wrap", "fn": "Bangle.setGPSPower", "id": "gpspower"},
        {"t": "cmd", "js": "WIDGETS.gpstrek.start(true)"},
        {"t": "assert", "js": "WIDGETS.gpstrek.getState().active", "is": "true"},
        {"t": "resetCall", "id": "gpspower", "text": "Ignore power calls made while starting"},
        {"t": "cmd", "js": "WIDGETS.gpstrek.stop(true)"},
        {"t": "assertCall", "id": "gpspower", "count": 0, "text": "Background stop keeps GPS running"},
        {"t": "assert", "js": "WIDGETS.gpstrek.getState().active", "is": "false"},
        {"t": "cmd", "js": "WIDGETS.gpstrek.stop(false)"},
        {"t": "assertCall", "id": "gpspower", "count": 1, "argAsserts": [{"t": "assert", "arg": "0", "is": "equal", "to": "0"}], "text": "Foreground stop disables GPS"}
      ]
    },
    {
      "description": "GPS fixes toggle compass power",
      "steps": [
        {"t": "cmd", "js": "global.WIDGETS={gpstrek:{}};eval(require('Storage').read('gpstrek.wid.js'));Bangle.isCompassOn=function(){return true}"},
        {"t": "wrap", "fn": "Bangle.setCompassPower", "id": "magpower"},
        {"t": "cmd", "js": "WIDGETS.gpstrek.start(false)"},
        {"t": "assertCall", "id": "magpower", "count": 1, "argAsserts": [{"t": "assert", "arg": "0", "is": "equal", "to": "1"}], "text": "Compass is enabled while searching"},
        {"t": "emit", "event": "GPS", "paramsArray": [{"fix": true, "lat": 52.52, "lon": 13.405}]},
        {"t": "assertCall", "id": "magpower", "count": 2, "argAsserts": [{"t": "assert", "arg": "0", "is": "equal", "to": "0"}], "text": "Compass is disabled once a fix is available"},
        {"t": "emit", "event": "GPS", "paramsArray": [{"fix": false}]},
        {"t": "assertCall", "id": "magpower", "count": 3, "argAsserts": [{"t": "assert", "arg": "0", "is": "equal", "to": "1"}], "text": "Compass is re-enabled when the fix is lost"}
      ]
    },
    {
      "description": "App cancels its routing timer on kill",
      "steps": [
        {"t": "cmd", "js": "global._gpstrekSettings=require('Storage').readJSON('setting.json',true)||{};global._gpstrekSettings.widgets=['gpstrek.wid.js'];require('Storage').writeJSON('setting.json',global._gpstrekSettings)"},
        {"t": "wrap", "fn": "global.setInterval", "id": "setint"},
        {"t": "wrap", "fn": "global.clearInterval", "id": "clearint"},
        {"t": "cmd", "js": "eval(require('Storage').read('gpstrek.app.js'))"},
        {"t": "assert", "js": "global.APPTESTS.funcCalls.setint >= 1", "is": "true", "text": "Routing interval is started"},
        {"t": "emit", "event": "kill", "parent": "E"},
        {"t": "assert", "js": "global.APPTESTS.funcCalls.clearint >= 1", "is": "true", "text": "Routing interval is cleared on kill"}
      ]
    }
  ]
}
